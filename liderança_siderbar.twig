<div class="ui blue segment">
    <h4 class="ui dividing header">
        <i class="trophy icon"></i>
        <div class="content">
            Configuração de Ranking
            <div class="sub header">Gerencie a periodicidade ou defina uma data manual para o encerramento.</div>
        </div>
    </h4>

    <div class="ui form">
        <div class="fields">
            
            <div class="field">
                <label>Visibilidade</label>
                <div class="ui segment basic secondary" style="padding: 10px;">
                    <div class="ui toggle checkbox" id="toggle-ranking">
                        <input type="checkbox" name="ranking_ativo" tabindex="0" class="hidden" {{ funcao.ranking_ativo ? 'checked' : '' }}>
                        <label>Exibir Ranking na Sidebar</label>
                    </div>
                    <div class="meta" style="margin-top: 5px; font-size: 0.85em; color: #666;">
                        <i class="info circle icon"></i> Se desmarcado, o bloco sumirá para todos os usuários.
                    </div>
                </div>
            </div>

            <div class="six wide field">
                <label>Tipo de Ciclo</label>
                <div class="ui selection dropdown fluid" id="dropdown-periodo">
                    <input type="hidden" name="ranking_tipo" id="input-ranking-tipo" value="{{ funcao.ranking_tipo | default('2') }}">
                    <i class="dropdown icon"></i>
                    <div class="default text">Selecione o período</div>
                    <div class="menu">
                        <div class="item" data-value="1">
                            <i class="calendar minus outline icon blue"></i> Semanal (Automático)
                        </div>
                        <div class="item" data-value="2">
                            <i class="star icon teal"></i> Quinzenal (Automático)
                        </div>
                        <div class="item" data-value="3">
                            <i class="calendar alternate outline icon purple"></i> Mensal (Automático)
                        </div>
                        <div class="divider"></div>
                        <div class="item" data-value="4">
                            <i class="clock outline icon orange"></i> Personalizado (Data Fixa)
                        </div>
                    </div>
                </div>
            </div>

            <div class="six wide field" id="campo-data-manual" style="display: none;">
                <label>Data/Hora de Encerramento</label>
                <div class="ui left icon input">
                    <i class="calendar check icon"></i>
                    <input type="datetime-local" name="ranking_data_fim" value="{{ funcao.ranking_data_fim ? funcao.ranking_data_fim|date('Y-m-d\\TH:i') : '' }}">
                </div>
                <div class="ui pointing below label red basic mini" style="display:none;" id="alert-data">
                    Defina a data limite para contagem.
                </div>
            </div>

        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        $('#toggle-ranking').checkbox();
        
        $('#dropdown-periodo').dropdown({
            onChange: function(value, text, $selectedItem) {
                toggleDataManual(value);
            }
        });

        function toggleDataManual(valor) {
            const campo = document.getElementById('campo-data-manual');
            const alerta = document.getElementById('alert-data');
            
            if (valor == '4') {
                $(campo).transition('slide down');
                const inputDate = campo.querySelector('input').value;
                if(!inputDate) alerta.style.display = 'block';
            } else {
                if ($(campo).is(':visible')) {
                    $(campo).transition('slide up');
                }
            }
        }

        const valorInicial = document.getElementById('input-ranking-tipo').value;
        if(valorInicial == '4') {
            document.getElementById('campo-data-manual').style.display = 'block';
        }
    });
</script>